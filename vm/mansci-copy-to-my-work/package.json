{
  "name": "@mansci/copy-to-my-work",
  "version": "0.3.1",
  "description": "Copy ManSci teaching materials and exchange team snapshots safely",
  "license": "BSD-3-Clause",
  "files": ["lib/**/*.js", "style/*.css"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension",
    "build:lib": "tsc",
    "build:labextension": "jupyter labextension build ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.0",
    "@jupyterlab/apputils": "^4.5.0",
    "@jupyterlab/coreutils": "^6.5.0",
    "@jupyterlab/filebrowser": "^4.5.0",
    "@jupyterlab/notebook": "^4.5.0",
    "@jupyterlab/services": "^7.5.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.6.0-alpha.5",
    "typescript": "~5.7.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "mansci_copy_to_my_work/labextension"
  },
  "packageManager": "yarn@3.5.0"
}

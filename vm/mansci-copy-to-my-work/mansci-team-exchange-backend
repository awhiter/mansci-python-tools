#!/opt/miniforge3/envs/mansci-python/bin/python
from __future__ import annotations

import fcntl
import grp
import json
import os
import pwd
import re
import secrets
import shutil
import sqlite3
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath

MODULES_FILE = Path("/etc/mansci/modules.conf")
ENROLMENTS_DIR = Path("/etc/mansci/enrolments")
CONFIG_FILE = Path("/etc/mansci/team-exchange.conf")
STATE_ROOT = Path("/srv/mansci/team-exchange")
FILES_ROOT = STATE_ROOT / "files"
DATABASE = STATE_ROOT / "teams.sqlite3"
LOCK_FILE = STATE_ROOT / ".lock"
MAX_ITEM_BYTES = 500 * 1024 * 1024
TEAM_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 '&().,_-]{1,39}$")
WORDS = ("MAPLE", "RIVER", "ORBIT", "CEDAR", "EMBER", "CORAL", "NOVA", "WILLOW")


class TeamError(RuntimeError):
    pass


@dataclass(frozen=True)
class Module:
    code: str
    directory: str
    display_name: str
    staff_group: str
    lead_account: str


def modules() -> dict[str, Module]:
    result = {}
    for raw in MODULES_FILE.read_text(encoding="utf-8").splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        fields = [field.strip() for field in raw.split("|")]
        if len(fields) == 5 and all(fields):
            module = Module(*fields)
            result[module.code.upper()] = module
    return result


def limits() -> dict[str, int]:
    result = {}
    try:
        lines = CONFIG_FILE.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return result
    for raw in lines:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        code, value = [part.strip() for part in raw.split("|", 1)]
        size = int(value)
        if size < 2 or size > 30:
            raise TeamError(f"Invalid team limit for {code}.")
        result[code.upper()] = size
    return result


def caller() -> str:
    username = os.environ.get("SUDO_USER", "")
    if not username or username == "root":
        raise TeamError("Team Exchange must be used from an authenticated ManSci account.")
    account = pwd.getpwnam(username)
    if account.pw_uid < 1000:
        raise TeamError("System accounts cannot use Team Exchange.")
    return username


def enrolled(username: str, module: Module) -> bool:
    path = ENROLMENTS_DIR / f"{module.code.lower()}_students.txt"
    try:
        return username in {
            line.strip() for line in path.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        }
    except FileNotFoundError:
        return False


def staff_users(module: Module) -> set[str]:
    users = {module.lead_account}
    try:
        users.update(grp.getgrnam(module.staff_group).gr_mem)
    except KeyError:
        pass
    return {
        name for name in users
        if name and _account(name) is not None
        and (Path(pwd.getpwnam(name).pw_dir) / "notebooks").is_dir()
    }


def _account(username: str):
    try:
        return pwd.getpwnam(username)
    except KeyError:
        return None


def is_staff(username: str, module: Module) -> bool:
    return username in staff_users(module) or username == "mansci-build"


def connect() -> sqlite3.Connection:
    db = sqlite3.connect(DATABASE)
    os.chmod(DATABASE, 0o600)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA foreign_keys=ON")
    db.executescript("""
        CREATE TABLE IF NOT EXISTS teams (
            id INTEGER PRIMARY KEY,
            module TEXT NOT NULL,
            name TEXT NOT NULL,
            name_key TEXT NOT NULL,
            join_code TEXT NOT NULL UNIQUE,
            created_by TEXT NOT NULL,
            created_at TEXT NOT NULL,
            UNIQUE(module, name_key)
        );
        CREATE TABLE IF NOT EXISTS members (
            module TEXT NOT NULL,
            username TEXT NOT NULL,
            team_id INTEGER NOT NULL REFERENCES teams(id) ON DELETE CASCADE,
            joined_at TEXT NOT NULL,
            PRIMARY KEY(module, username)
        );
        CREATE TABLE IF NOT EXISTS events (
            id INTEGER PRIMARY KEY,
            occurred_at TEXT NOT NULL,
            module TEXT NOT NULL,
            team_id INTEGER,
            username TEXT NOT NULL,
            action TEXT NOT NULL,
            detail TEXT NOT NULL
        );
    """)
    return db


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def event(db, module, team_id, username, action, detail=""):
    db.execute(
        "INSERT INTO events(occurred_at,module,team_id,username,action,detail) VALUES(?,?,?,?,?,?)",
        (now(), module.code, team_id, username, action, detail),
    )


def module_for(code: str) -> Module:
    try:
        module = modules()[str(code).upper()]
    except KeyError:
        raise TeamError("Unknown module.")
    return module


def require_module_access(username: str, module: Module):
    if not enrolled(username, module) and not is_staff(username, module):
        raise TeamError(f"{username} is not enrolled on or authorised for {module.code}.")


def team_dir(module: Module, team_id: int) -> Path:
    return FILES_ROOT / module.code.lower() / f"team-{team_id}"


def safe_link_name(name: str) -> str:
    return name.replace("/", "-")


def exchange_module_dir(username: str, module: Module) -> Path:
    return Path(pwd.getpwnam(username).pw_dir) / "notebooks/Team Exchange" / module.display_name


def apply_acl(path: Path, username: str, add: bool):
    if add:
        subprocess.run(["setfacl", "-R", "-m", f"u:{username}:r-X", str(path)], check=True)
        directories = [path, *[p for p in path.rglob("*") if p.is_dir()]] if path.is_dir() else []
        for directory in directories:
            subprocess.run(["setfacl", "-m", f"d:u:{username}:r-X", str(directory)], check=True)
    else:
        subprocess.run(["setfacl", "-R", "-x", f"u:{username}", str(path)], check=False)
        for directory in [path, *[p for p in path.rglob("*") if p.is_dir()]]:
            subprocess.run(["setfacl", "-x", f"d:u:{username}", str(directory)], check=False)


def add_link(username: str, module: Module, team: sqlite3.Row):
    account = pwd.getpwnam(username)
    parent = exchange_module_dir(username, module)
    parent.mkdir(parents=True, exist_ok=True)
    os.chown(parent.parent, account.pw_uid, account.pw_gid)
    os.chown(parent, account.pw_uid, account.pw_gid)
    os.chmod(parent.parent, 0o700)
    os.chmod(parent, 0o700)
    link = parent / safe_link_name(team["name"])
    target = team_dir(module, team["id"])
    for existing in parent.iterdir():
        if existing.is_symlink() and existing.resolve(strict=False) == target and existing != link:
            existing.unlink()
    if link.is_symlink():
        if link.resolve(strict=False) != target:
            raise TeamError(f"Unexpected Team Exchange link at {link}.")
    elif link.exists():
        raise TeamError(f"A non-link item already uses the team name {team['name']}.")
    else:
        link.symlink_to(target)
        os.lchown(link, account.pw_uid, account.pw_gid)


def remove_links(username: str, module: Module, team_id: int):
    parent = exchange_module_dir(username, module)
    if not parent.is_dir():
        return
    target = team_dir(module, team_id)
    for item in parent.iterdir():
        if item.is_symlink() and item.resolve(strict=False) == target:
            item.unlink()


def grant_access(username: str, module: Module, team: sqlite3.Row):
    path = team_dir(module, team["id"])
    apply_acl(path, username, True)
    add_link(username, module, team)


def revoke_access(username: str, module: Module, team: sqlite3.Row):
    remove_links(username, module, team["id"])
    apply_acl(team_dir(module, team["id"]), username, False)


def create_code(db) -> str:
    for _ in range(100):
        code = f"{secrets.choice(WORDS)}-{secrets.randbelow(90) + 10}"
        if not db.execute("SELECT 1 FROM teams WHERE join_code=?", (code,)).fetchone():
            return code
    raise TeamError("Could not allocate a join code. Please try again.")


def public_team(db, module: Module, team: sqlite3.Row, include_code=True):
    members = [row[0] for row in db.execute(
        "SELECT username FROM members WHERE team_id=? ORDER BY joined_at, username", (team["id"],)
    )]
    result = {
        "id": team["id"], "module": module.code, "module_name": module.display_name,
        "name": team["name"], "members": members, "member_count": len(members),
        "maximum_members": limits().get(module.code, 6),
    }
    if include_code:
        result["join_code"] = team["join_code"]
    return result


def status(db, username: str, payload: dict):
    result = []
    for module in modules().values():
        if not enrolled(username, module) and not is_staff(username, module):
            continue
        if is_staff(username, module):
            rows = list(db.execute(
                "SELECT * FROM teams WHERE module=? ORDER BY name_key", (module.code,)
            ))
            # Reconcile access here as well as at team creation so a newly added
            # member of teaching staff can see existing exchanges immediately.
            for row in rows:
                grant_access(username, module, row)
            teams = [public_team(db, module, row) for row in rows]
            result.append({
                "code": module.code, "name": module.display_name, "role": "staff",
                "maximum_members": limits().get(module.code, 6), "teams": teams,
            })
        else:
            team = db.execute(
                "SELECT t.* FROM teams t JOIN members m ON m.team_id=t.id WHERE m.module=? AND m.username=?",
                (module.code, username),
            ).fetchone()
            result.append({
                "code": module.code, "name": module.display_name, "role": "student",
                "maximum_members": limits().get(module.code, 6),
                "team": public_team(db, module, team) if team else None,
            })
    return {"modules": result}


def create_team(db, username: str, payload: dict):
    module = module_for(payload.get("module", ""))
    require_module_access(username, module)
    if is_staff(username, module):
        raise TeamError("Teaching staff do not create student teams.")
    name = " ".join(str(payload.get("name", "")).split())
    if not TEAM_NAME_RE.fullmatch(name):
        raise TeamError("Use a team name of 2–40 letters, numbers, spaces or simple punctuation.")
    if db.execute("SELECT 1 FROM members WHERE module=? AND username=?", (module.code, username)).fetchone():
        raise TeamError("You already belong to a team for this module.")
    code = create_code(db)
    try:
        cursor = db.execute(
            "INSERT INTO teams(module,name,name_key,join_code,created_by,created_at) VALUES(?,?,?,?,?,?)",
            (module.code, name, name.casefold(), code, username, now()),
        )
    except sqlite3.IntegrityError:
        raise TeamError("That team name is already in use for this module.")
    team_id = cursor.lastrowid
    db.execute("INSERT INTO members VALUES(?,?,?,?)", (module.code, username, team_id, now()))
    path = team_dir(module, team_id)
    path.mkdir(parents=True)
    os.chmod(path.parent, 0o711)
    os.chmod(path, 0o700)
    team = db.execute("SELECT * FROM teams WHERE id=?", (team_id,)).fetchone()
    for staff in staff_users(module):
        grant_access(staff, module, team)
    grant_access(username, module, team)
    event(db, module, team_id, username, "create", name)
    return {"team": public_team(db, module, team)}


def join_team(db, username: str, payload: dict):
    module = module_for(payload.get("module", ""))
    require_module_access(username, module)
    if is_staff(username, module):
        raise TeamError("Teaching staff already have oversight access.")
    if db.execute("SELECT 1 FROM members WHERE module=? AND username=?", (module.code, username)).fetchone():
        raise TeamError("Leave your current team before joining another one.")
    code = str(payload.get("code", "")).strip().upper()
    team = db.execute("SELECT * FROM teams WHERE module=? AND join_code=?", (module.code, code)).fetchone()
    if not team:
        raise TeamError("That join code is not valid for this module.")
    maximum = limits().get(module.code, 6)
    count = db.execute("SELECT COUNT(*) FROM members WHERE team_id=?", (team["id"],)).fetchone()[0]
    if count >= maximum:
        raise TeamError(f"{team['name']} already has its maximum of {maximum} students.")
    db.execute("INSERT INTO members VALUES(?,?,?,?)", (module.code, username, team["id"], now()))
    grant_access(username, module, team)
    event(db, module, team["id"], username, "join")
    return {"team": public_team(db, module, team)}


def leave_team(db, username: str, payload: dict):
    module = module_for(payload.get("module", ""))
    require_module_access(username, module)
    row = db.execute(
        "SELECT t.* FROM teams t JOIN members m ON m.team_id=t.id WHERE m.module=? AND m.username=?",
        (module.code, username),
    ).fetchone()
    if not row:
        raise TeamError("You do not currently belong to a team for this module.")
    db.execute("DELETE FROM members WHERE module=? AND username=?", (module.code, username))
    revoke_access(username, module, row)
    event(db, module, row["id"], username, "leave")
    return {"message": f"You have left {row['name']}. Shared snapshots remain with the team."}


def validate_source(username: str, module: Module, source: str) -> Path:
    rel = PurePosixPath(source)
    prefix = PurePosixPath("My Work", module.display_name)
    if rel.is_absolute() or ".." in rel.parts or tuple(rel.parts[:2]) != prefix.parts or len(rel.parts) < 3:
        raise TeamError(f"Select an item inside My Work/{module.display_name}.")
    root = Path(pwd.getpwnam(username).pw_dir) / "notebooks"
    candidate = root.joinpath(*rel.parts)
    if not candidate.exists() or candidate.is_symlink():
        raise TeamError("The selected item does not exist or is a symbolic link.")
    if candidate.is_dir() and any(path.is_symlink() for path in candidate.rglob("*")):
        raise TeamError("Folders containing symbolic links cannot be shared.")
    total = sum(path.stat().st_size for path in ([candidate] if candidate.is_file() else candidate.rglob("*")) if path.is_file())
    if total > MAX_ITEM_BYTES:
        raise TeamError("This item is too large for Team Exchange (maximum 500 MB).")
    return candidate


def share(db, username: str, payload: dict):
    module = module_for(payload.get("module", ""))
    require_module_access(username, module)
    team = db.execute(
        "SELECT t.* FROM teams t JOIN members m ON m.team_id=t.id WHERE m.module=? AND m.username=?",
        (module.code, username),
    ).fetchone()
    if not team:
        raise TeamError("Create or join a team before sharing work.")
    source = validate_source(username, module, str(payload.get("source", "")))
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    suffix = "".join(source.suffixes) if source.is_file() else ""
    base = source.name[:-len(suffix)] if suffix else source.name
    name = f"{base}__from-{username}__{stamp}{suffix}"
    destination = team_dir(module, team["id"]) / name
    counter = 2
    while destination.exists():
        destination = destination.with_name(f"{base}__from-{username}__{stamp}-{counter}{suffix}")
        counter += 1
    if source.is_dir():
        shutil.copytree(source, destination, symlinks=False)
    else:
        shutil.copy2(source, destination)
    for path in [destination, *destination.rglob("*")] if destination.is_dir() else [destination]:
        os.chown(path, 0, 0)
        os.chmod(path, 0o500 if path.is_dir() else 0o400)
    for member in [row[0] for row in db.execute("SELECT username FROM members WHERE team_id=?", (team["id"],))]:
        apply_acl(destination, member, True)
    for staff in staff_users(module):
        apply_acl(destination, staff, True)
    event(db, module, team["id"], username, "share", destination.name)
    return {"message": f"Shared as {destination.name} in Team Exchange — {team['name']}.", "name": destination.name}


def main() -> int:
    try:
        if os.geteuid() != 0:
            raise TeamError("This protected helper must run through sudo.")
        username = caller()
        payload = json.load(sys.stdin)
        action = payload.get("action", "status")
        STATE_ROOT.mkdir(parents=True, exist_ok=True)
        FILES_ROOT.mkdir(parents=True, exist_ok=True)
        os.chmod(STATE_ROOT, 0o711)
        os.chmod(FILES_ROOT, 0o711)
        LOCK_FILE.touch(mode=0o600, exist_ok=True)
        with LOCK_FILE.open("r+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with connect() as db:
                result = {
                    "status": status,
                    "create": create_team,
                    "join": join_team,
                    "leave": leave_team,
                    "share": share,
                }.get(action)
                if result is None:
                    raise TeamError("Unknown Team Exchange action.")
                response = result(db, username, payload)
        print(json.dumps(response))
        return 0
    except (TeamError, OSError, ValueError, KeyError, sqlite3.Error, subprocess.CalledProcessError) as exc:
        print(json.dumps({"error": str(exc)}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
